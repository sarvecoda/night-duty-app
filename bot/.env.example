# Vercel project Root Directory must be bot.
# Copy these into that Vercel project. Do not commit real values.

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Meta WhatsApp Cloud API. The test number works before the SIM arrives.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANG=en

# Personal Groq account, not the one used by the work Dashboard.
GROQ_API_KEY=
GROQ_MODEL_MEMBER=openai/gpt-oss-20b
GROQ_MODEL_ADMIN=openai/gpt-oss-120b

# Vercel sends this as Authorization: Bearer <value> on cron calls.
CRON_SECRET=
